# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env in your project root (next to package.json)
# Fill in ALL values — then restart npm start
#
# WHERE TO FIND THESE:
#  Google Maps → console.cloud.google.com → APIs & Services → Credentials
#  Firebase    → console.firebase.google.com → Project Settings → Your apps
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Maps ───────────────────────────────────────────────────────────────
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
REACT_APP_MAP_ID=

# ── Firebase ──────────────────────────────────────────────────────────────────
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
