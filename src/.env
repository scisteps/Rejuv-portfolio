# Place this file at your PROJECT ROOT (same folder as package.json)
# Rename it to exactly ".env" (just remove ".example")
#
# IMPORTANT for Create React App:
# - Variable name MUST start with REACT_APP_ or CRA will ignore it
# - No quotes around the value
# - No spaces around the "="
# - You MUST restart "npm start" after creating/editing this file —
#   hot reload does NOT pick up .env changes

REACT_APP_GOOGLE_MAPS_API_KEY=your_actual_key_goes_here
REACT_APP_MAP_ID=your_map_id_here_or_leave_blank_for_now
